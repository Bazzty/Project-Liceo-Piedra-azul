APP_NAME="Leer para Todos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Debe coincidir con el .env de la raíz (docker-compose). Desde Docker el host será "db".
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=leer_para_todos
DB_USERNAME=leer
DB_PASSWORD=

# Dominios del frontend que pueden iniciar sesión con cookie (Sanctum SPA).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Proxies o balanceadores delante de nginx (IP o rangos, separados por coma). Solo los que controlas: un cliente
# directo podría falsear su IP. Sin esto, todos comparten el cupo de intentos de ingreso de cada correo.
# TRUSTED_PROXIES=10.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Voz del proyecto. Sin ELEVENLABS_* la API usa Piper (local, gratis); con ellos, Piper queda de respaldo.
# TTS_DRIVER=piper fuerza solo la voz local. La clave vive aquí, nunca en el frontend ni en git.
TTS_DRIVER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_IDIOMA=es
# TTS_MAX_CARACTERES=600

# Contraseña de la docente de demostración (php artisan db:seed --class=DocenteDemoSeeder). Solo en local.
DEMO_DOCENTE_CLAVE=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IA que redacta el borrador del cuento (botón «Crear con IA»): modelo abierto en Ollama, sin costo por uso.
# Con Docker: `docker compose --profile ia up -d` y OLLAMA_URL=http://ollama:11434. También puede ser un servidor remoto.
OLLAMA_URL=
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_API_KEY=
# OLLAMA_ESPERA=90
# Hilos de CPU del modelo (opcional; vacío = Ollama elige). Probar con 6 u 8 en equipos de 8 o más núcleos.
# OLLAMA_HILOS=
