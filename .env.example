# Copia este archivo a .env (make up lo hace solo). No subas .env al repositorio.
# Valores solo para desarrollo local; en producción se cambian y nunca se guardan aquí.

DB_DATABASE=leer_para_todos
DB_USERNAME=leer
DB_PASSWORD=cambiar_en_local
DB_PORT=5432

# Puertos en tu máquina: cámbialos si ya los usas para otra cosa.
WEB_PORT=8000
VITE_PORT=5173
# Pon 0.0.0.0 para abrir la web desde otro equipo de tu red, como una tableta. Queda visible para toda esa red.
# VITE_HOST=127.0.0.1
# Pon true si Vite no detecta los cambios de archivos (carpeta del proyecto en el disco de Windows).
VITE_USE_POLLING=false
