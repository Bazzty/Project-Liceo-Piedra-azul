# Copia este archivo como .env.local y completa los valores. .env.local NO se sube a git.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Estas dos claves las usa el script `npm run audios`. La API del servidor lee las suyas en backend/.env.

# Cuenta de demostración del panel docente (la crea DocenteDemoSeeder). Va en frontend/.env.development.local
# (Vite solo lo carga con `npm run dev`). Si la pones en .env.local, `npm run build` la incrusta en el JS.
# VITE_DEMO_CORREO=profesora@piedraazul.cl
# VITE_DEMO_CLAVE=

# Opcionales (valores por defecto entre paréntesis)
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_IDIOMA=es
# VOZ_ESTABILIDAD=0.3
# VOZ_SIMILITUD=1
# VOZ_VELOCIDAD=1
